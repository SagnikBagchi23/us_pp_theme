{
  "expo": {
    "name": "US Stocks Product Page",
    "slug": "us-stocks-product-page",
    "version": "1.0.0",
    "scheme": "us-stocks-product",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#060809"
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to customize the stock page background."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
